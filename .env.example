# Copia este archivo a .env.local y rellena los valores.
# Solo servidor: nunca uses el prefijo NEXT_PUBLIC_ con estas variables.

# Clave de la API de Resend (https://resend.com/api-keys)
RESEND_API_KEY=

# Destinatario de los mensajes del formulario de contacto.
# Con el remitente por defecto (onboarding@resend.dev) Resend solo entrega
# al correo del propietario de la cuenta de Resend.
CONTACT_TO_EMAIL=

# Opcional. Por defecto: "Arcade Vault <onboarding@resend.dev>"
# Para usar otro remitente hay que verificar un dominio en Resend.
CONTACT_FROM_EMAIL=

# --- Supabase (cliente de navegador y de servidor) ---
# Estas dos variables llevan NEXT_PUBLIC_ a propósito: se incluyen en el bundle
# del navegador. Solo pueden contener valores públicos. Nunca pongas aquí la
# clave service_role ni la contraseña de la base de datos.

# URL del proyecto. Dashboard de Supabase > Project Settings > API
# (o la herramienta get_project_url del MCP). Formato: https://<project_ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clave publicable (sb_publishable_...). Dashboard de Supabase > Project Settings
# > API Keys (o get_publishable_keys del MCP). Es segura en el cliente solo si
# todas las tablas tienen RLS activado.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Supabase Auth (SPEC 12) ---
# No hay variables nuevas: la autenticación usa las dos NEXT_PUBLIC_ de arriba.
# Lo siguiente se configura a mano en el Dashboard de Supabase; sin ello el
# enlace del correo y OAuth fallan y /auth muestra "?error=callback".
#
# Authentication > URL Configuration
#   - Site URL: la URL de producción (en local: http://localhost:3000)
#   - Redirect URLs: <origen>/auth/callback para cada origen
#     (http://localhost:3000/auth/callback y el dominio de producción)
# Authentication > Providers
#   - Email: activado, con "Confirm email" activado (confirmación obligatoria)
#   - Google y GitHub: activados con su Client ID y Client Secret. En cada
#     proveedor, la callback URL es https://<project_ref>.supabase.co/auth/v1/callback
# Authentication > Emails > Confirm signup: la plantilla por defecto sirve;
#   si se personaliza, el enlace debe usar {{ .ConfirmationURL }}.

# --- Seguridad (SPEC 13) ---
# Tampoco hay variables nuevas. Configuración manual en el Dashboard de Supabase:
#
# Authentication > Sign In / Providers > Email (política de contraseña)
#   - Minimum password length: 8
#   - Password requirements: minúsculas, mayúsculas, dígitos y símbolos
#   Debe coincidir con validatePassword (lib/auth/validation.ts). Se comprueba con
#   POST /auth/v1/signup: una contraseña de 7 caracteres, o de 8 sin símbolo,
#   debe responder 422 con "weak_password".
# Authentication > Rate Limits
#   - Sign ups and sign ins: 10 por IP cada 5 minutos (el valor por defecto es 30)
# Leaked password protection: solo existe en el plan Pro, así que con el plan
#   Free el advisor mantiene el aviso auth_leaked_password_protection. La
#   mitigación es isPasswordPwned (lib/auth/pwned.ts), que consulta HaveIBeenPwned
#   en signUp; al pasar a Pro se activa aquí y se puede retirar ese archivo.
